# Copy this file to .env and fill it in. .env is gitignored - never commit it.

# Secret key used to turn customer names into anonymous IDs.
# Use a long random string (16+ characters) and keep it the same between runs.
CUSTOMER_HASH_SALT=

# Email settings, only needed for `python -m src.run --send`.
# For Gmail, create an "app password" (Google Account > Security) and use it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_TO=
